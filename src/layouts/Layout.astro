---
import "@fontsource-variable/inter";
import "@fontsource-variable/inter-tight";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "../styles/global.css";
import { identity, seo, contacts } from "../data/portfolio";

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  noindex?: boolean;
}
const {
  title = seo.title,
  description = seo.description,
  article = false,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const asset = (path: string) => `${import.meta.env.BASE_URL}${path}`;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: identity.name,
  alternateName: identity.displayName,
  jobTitle: identity.role,
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  sameAs: contacts
    .filter(({ href }) => href.startsWith("https://"))
    .map(({ href }) => href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F8F8F5" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Tan To" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={new URL(asset("og.png"), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Tan To. Making complex systems reliable. Platform / Cloud / AI Infrastructure."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(asset("og.png"), Astro.site)} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(person).replace(/</g, "\\u003c")}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
