---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {label === "LinkedIn" ? (
    <>
      <rect x="1" y="1" width="22" height="22" rx="1.5" fill="currentColor" />
      <g fill="var(--paper)">
        <circle cx="6.5" cy="7" r="1.65" />
        <path d="M5 10h3v9H5zM10 10h2.9v1.25c.7-1 1.65-1.5 2.95-1.5 2.7 0 3.65 1.7 3.65 4.4V19h-3v-4.4c0-1.35-.25-2.2-1.55-2.2-1.4 0-1.95 1-1.95 2.45V19h-3z" />
      </g>
    </>
  ) : label.startsWith("Telegram") ? (
    <>
      <circle cx="12" cy="12" r="11" fill="currentColor" />
      <path
        d="m5.5 11.5 12.1-4.7c.6-.2 1 .1.8.9l-2 9.5c-.1.7-.5.9-1 .5l-3.1-2.3-1.5 1.5c-.2.2-.3.3-.6.3l.2-3.2 5.8-5.2c.3-.2 0-.4-.4-.2l-7.2 4.5-3.1-1c-.7-.2-.7-.6 0-.8Z"
        fill="var(--paper)"
      />
    </>
  ) : (
    <path
      d="M5 19 19 5M5 5h14v14"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    />
  )}
</svg>
