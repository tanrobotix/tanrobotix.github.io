---
import {
  identity,
  projects,
  experience,
  capabilities,
  about,
  contacts,
} from "../data/portfolio";
import Arrow from "./Arrow.astro";
import ComputeFabric from "./ComputeFabric.astro";
import ContactIcon from "./ContactIcon.astro";

interface Props {
  notes?: { title: string; description: string; href: string; date: string }[];
}
const { notes = [] } = Astro.props;
const [featured, ...otherProjects] = projects;
const number = (index: number) => String(index).padStart(2, "0");
---

<a class="skip-link" href="#main">
  Skip to content
</a>
<header class="site-header page-width">
  <a
    class="wordmark"
    href="#top"
    aria-label={`${identity.displayName} — back to top`}
  >
    TAN TO<span>.</span>
  </a>
  <span class="header-label mono">PLATFORM & INFRASTRUCTURE</span>
  <nav aria-label="Main navigation">
    <a href="#work">Work</a>
    <a href="#experience">Experience</a>
    <a href="#about">About</a>
    <a href="#contact">
      Contact <span aria-hidden="true">↗</span>
    </a>
  </nav>
</header>
<main id="main" class="page-width" tabindex="-1">
  <section id="top" class="hero" aria-labelledby="hero-title">
    <div class="hero-eyebrow mono">
      <span>{identity.name} — Infrastructure engineer</span>
      <span class="hero-edition">
        INDEPENDENT IN THOUGHT. PRECISE IN PRACTICE.
      </span>
    </div>
    <div class="hero-heading-wrap">
      <h1 id="hero-title">
        Making complex
        <br />
        systems reliable<span class="accent">.</span>
      </h1>
      <svg
        class="hero-mark"
        width="70"
        height="70"
        viewBox="0 0 70 70"
        aria-hidden="true"
      >
        <path
          d="M0 0h70v14H14v56H0zM28 28h42v14H42v28H28zM56 56h14v14H56z"
          fill="currentColor"
        />
      </svg>
    </div>
    <div class="hero-bottom editorial-grid">
      <div class="hero-identity">
        <p class="mono">{identity.role}</p>
        <p class="location">
          <span class="location-dot" aria-hidden="true"></span>
          {identity.location}
        </p>
      </div>
      <div class="hero-intro">
        <p>{identity.summary}</p>
        <a class="text-link" href="#work">
          Explore selected work <Arrow />
        </a>
      </div>
      <div class="hero-index mono" aria-hidden="true">
        CLOUD / DATA / COMPUTE
        <br />
        SCROLL TO EXPLORE ↓
      </div>
    </div>
  </section>

  <section id="work" class="section work-section" aria-labelledby="work-title">
    <div class="section-heading editorial-grid">
      <p class="section-label mono">01 / SELECTED WORK</p>
      <h2 id="work-title">
        Systems, platforms,
        <br />
        and things I’ve built.
      </h2>
      <p class="section-aside">
        Professional experience.
        <br />
        Independent explorations.
      </p>
    </div>
    {featured && (
      <article class="featured-project editorial-grid" id={featured.id}>
        <div class="project-number mono">01 / 05</div>
        <div class="featured-copy">
          <p class="project-category mono">{featured.category}</p>
          <h3>
            {featured.href ? (
              <a href={featured.href}>
                {featured.title}
                <Arrow diagonal />
              </a>
            ) : (
              featured.title
            )}
          </h3>
          <p class="project-description">{featured.description}</p>
          <p class="technology-list mono">
            {featured.technologies.join(" / ")}
          </p>
          <span class="work-kind mono">Professional experience</span>
        </div>
        <ComputeFabric />
      </article>
    )}
    <div class="project-index">
      {otherProjects.map((project, index) => (
        <article class="project-row editorial-grid" id={project.id}>
          <p class="project-number mono">{number(index + 2)}</p>
          <div class="project-row-main">
            <h3>
              {project.href ? (
                <a href={project.href}>
                  {project.title}
                  <Arrow diagonal />
                </a>
              ) : (
                project.title
              )}
            </h3>
            <p class="project-description">{project.description}</p>
          </div>
          <div class="project-row-meta">
            <p class="project-category mono">{project.category}</p>
            <p class="technology-list mono">
              {project.technologies.join(" / ")}
            </p>
            <p class="work-kind mono">
              {project.kind === "professional"
                ? "Professional experience"
                : "Independent work"}
            </p>
          </div>
          <span class="project-row-mark" aria-hidden="true">
            {project.href ? "↗" : "+"}
          </span>
        </article>
      ))}
    </div>
  </section>

  <section id="experience" class="section" aria-labelledby="experience-title">
    <div class="section-heading editorial-grid">
      <p class="section-label mono">02 / EXPERIENCE</p>
      <h2 id="experience-title">Where I’ve worked.</h2>
    </div>
    <div class="experience-index">
      {experience.map((entry, index) => (
        <article class="experience-row editorial-grid">
          <span class="experience-number mono">{number(index + 1)}</span>
          <h3>{entry.company}</h3>
          <div class="experience-role">
            <p>{entry.role}</p>
            {entry.dates && <p class="mono">{entry.dates}</p>}
          </div>
          <p class="experience-focus">{entry.focus}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="expertise" class="section" aria-labelledby="expertise-title">
    <div class="section-heading editorial-grid">
      <p class="section-label mono">03 / EXPERTISE</p>
      <h2 id="expertise-title">
        From cloud platforms
        <br />
        to GPU clusters.
      </h2>
    </div>
    <div class="capability-grid">
      {capabilities.map((capability, index) => (
        <article class="capability">
          <p class="mono capability-number">
            {number(index + 1)}
            <span aria-hidden="true">↗</span>
          </p>
          <h3>{capability.title}</h3>
          <p class="capability-description">{capability.description}</p>
          <p class="technology-list mono">
            {capability.technologies.join(" / ")}
          </p>
        </article>
      ))}
    </div>
  </section>

  <section
    id="about"
    class="section about-section"
    aria-labelledby="about-title"
  >
    <div class="section-heading editorial-grid">
      <p class="section-label mono">04 / ABOUT</p>
      <h2 id="about-title">
        An engineer,
        <br />
        always curious.
      </h2>
    </div>
    <div class="about-content editorial-grid">
      <blockquote>{about.statement}</blockquote>
      <div class="about-prose">
        {about.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <p class="about-signature">
          {identity.displayName}
          <span class="mono">{identity.location}</span>
        </p>
      </div>
    </div>
  </section>

  {notes.length > 0 && (
    <section
      id="notes"
      class="section notes-section"
      aria-labelledby="notes-title"
    >
      <div class="section-heading editorial-grid">
        <p class="section-label mono">05 / NOTES</p>
        <h2 id="notes-title">Notes from practice.</h2>
      </div>
      <div class="notes-index">
        {notes.map((note) => (
          <article class="note-row editorial-grid">
            <p class="mono">{note.date}</p>
            <div>
              <h3>
                <a href={note.href}>
                  {note.title}
                  <Arrow diagonal />
                </a>
              </h3>
              <p>{note.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section
    id="contact"
    class="section contact-section"
    aria-labelledby="contact-title"
  >
    <p class="section-label mono">06 / CONTACT</p>
    <div class="contact-heading">
      <h2 id="contact-title">
        Have something
        <br />
        interesting in mind<span class="accent">?</span>
      </h2>
      {contacts.length > 0 && (
        <ul class="contact-links" role="list" aria-label="Contact profiles">
          {contacts.map((contact) => (
            <li>
              <a
                href={contact.href}
                aria-label={`Contact ${identity.displayName} on ${contact.label}`}
                title={contact.label}
              >
                <ContactIcon label={contact.label} />
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
    <div class="contact-bottom editorial-grid">
      <p class="contact-location mono">
        BASED IN
        <br />
        {identity.location}
      </p>
      <a class="back-to-top mono" href="#top">
        BACK TO TOP ↑
      </a>
    </div>
  </section>
</main>
<footer class="site-footer page-width">
  <p class="mono">TAN TO — ENGINEERING SYSTEMS WITH INTENT.</p>
  <p class="mono">© {new Date().getFullYear()}</p>
</footer>
